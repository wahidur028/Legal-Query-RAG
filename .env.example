# Required for response generation and query refinement
GROQ_API_KEY=

# Required for TruLens answer/context/groundedness evaluation
OPENAI_API_KEY=
OPENAI_EVALUATOR_MODEL=gpt-4o-mini

# Optional for gated Hugging Face models
HF_TOKEN=

# Reproducible model configuration
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=avsolatorio/GIST-large-Embedding-v0
RERANKER_MODEL=BAAI/bge-reranker-large

# Feedback policy
MAX_REFINEMENTS=2
MIN_ANSWER_RELEVANCE=0.60
MIN_CONTEXT_RELEVANCE=0.50
MIN_GROUNDEDNESS=0.60
ALLOW_UNGROUNDED_FALLBACK=false

# Local serving is the safe default
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GRADIO_MAX_FILE_SIZE=20mb
LOG_LEVEL=INFO
